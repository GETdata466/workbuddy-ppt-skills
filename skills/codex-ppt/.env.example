# ---------------------------------------------------------------------------
# codex-ppt / image-to-editable-ppt 共用运行时配置模板
#
# 放到（任选其一，优先第一个）：
#   ~/.workbuddy/ppt-skill/.env
#   ~/.codex-ppt-skill/.env          # 旧目录，仅在新目录没有 .env 时生效
#
# 推荐用脚本改，而不是手写：
#   python scripts/codex_ppt_runtime.py config --provider auto \
#     --api-base-url https://your-relay.example.com/v1 --api-key sk-...
#
# 注意：这个文件只影响「生图」后端。OCR token 属于另一个文件
# （~/.editppt/config.yaml，用 `editppt config --paddle-ocr-token` 设置）。
# ---------------------------------------------------------------------------

# 默认额度来源，对应 image_gen.py 的 --provider 缺省值。
#   auto        跟随下面 OPENAI_BASE_URL；失败时允许回落到 CODEX_PPT_FALLBACK_BASE_URL
#   codex-oauth 强制本机 ChatGPT 订阅额度；不回落到任何付费接口
#   api         强制走中转站 / OpenAI 兼容 API
# 技能在生成第一张图之前会询问用户，用 --provider 覆盖这里，因此本项只是兜底。
CODEX_PPT_DEFAULT_PROVIDER=auto

# ---- 路径一：本机 Codex 订阅额度（零 API 费用）--------------------------------
# 需要本机装好 Codex CLI 且已登录 ChatGPT 账号（codex login status 显示已登录）。
# 使用这条路径时 OPENAI_API_KEY 可以留空。
OPENAI_BASE_URL=codex-oauth://local

# ---- 路径二：中转站 / 任意 OpenAI 兼容 API（按量计费）-------------------------
# 用户选择「中转站 API」时使用。命令：image_gen.py ... --provider api
CODEX_PPT_API_BASE_URL=https://your-relay.example.com/v1
OPENAI_API_KEY=

# ---- 自动回落的付费端点（仅 --provider auto 会用到）---------------------------
# 若不想让任何失败悄悄产生费用，把这一行删掉或留空。
CODEX_PPT_FALLBACK_BASE_URL=

# ---- 模型与输出 ---------------------------------------------------------------
# 需包含 gpt-image- 前缀，例如 gpt-image-2.5-flare / gpt-image-2.5-sunburst / gpt-image-2
CODEX_PPT_IMAGE_MODEL=gpt-image-2.5-flare

# ---- 可选：代理、超时、并发 ---------------------------------------------------
# 订阅额度路径需要访问 chatgpt.com。脚本会自动探测 7897/7890/7891/7892/10808/1080，
# 探测不准时在这里固定一个（Clash 的 HTTP 端口通常是 7892）。
# CODEX_PPT_PROXY=http://127.0.0.1:7892
# 只探测指定端口（逗号或空格分隔），与上一项二选一即可
# CODEX_PPT_PROXY_PORTS=7892,7897
# 单页超时秒数；订阅额度路径每页常见 60–120 秒，别设太小
# CODEX_PPT_TIMEOUT=600
# 同时运行的 Codex 进程数上限
# CODEX_PPT_MAX_PARALLEL=3
# 每个请求的临时工作目录；系统 TEMP 受限或报 Permission denied 时指定到别处
# CODEX_PPT_SCRATCH=~/.workbuddy/ppt-skill/scratch

# ---- 不作为 .env 项 -----------------------------------------------------------
# CODEX_PPT_HOME 必须在 shell 里 export 才生效（脚本在读取 .env 之前就要确定
# 配置目录位置），写在下面这行没有作用。
# CODEX_PPT_HOME=~/.workbuddy/ppt-skill
